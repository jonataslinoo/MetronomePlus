<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:height="10dp"
        android:gravity="bottom">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:centerColor="@color/toolbar_bar_center_color"
                android:endColor="@color/toolbar_bar_end_color"
                android:startColor="@android:color/transparent" />
        </shape>
    </item>
    <item android:bottom="6dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/window_background_app" />
        </shape>
    </item>
</layer-list>