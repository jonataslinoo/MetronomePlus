<resources>
    <!-- Base application theme. -->
    <style name="Base.Theme.MetronomePlus" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:windowBackground">@color/window_background_app</item>
        <item name="colorPrimary">@color/beat_highlight_color</item>
    </style>

    <style name="defaultButtonStyle" parent="@android:style/Widget.Button">
        <item name="android:textColor">@drawable/metronome_button_text_color_state</item>
        <item name="android:background">@drawable/metronome_button_state</item>
    </style>

    <style name="textTitleDisplayStyle">
        <item name="android:textColor">@color/display_screen_color</item>
        <item name="android:textSize">@dimen/font_size_title_numbers_display</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAlignment">center</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:background">@color/beat_default_color</item>
    </style>

    <style name="textNumberDisplayStyle">
        <item name="android:fontFamily">@font/ds_digib</item>
        <item name="android:textSize">48sp</item>
        <item name="android:textAlignment">textEnd</item>
        <item name="android:textColor">@color/beat_highlight_color</item>
    </style>

    <style name="bottomNavigationStyle" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:background">@color/window_background_app</item>
        <item name="itemIconTint">@color/white</item>
        <item name="itemTextColor">@color/selector_text_color_bottom_nav</item>
        <item name="itemRippleColor">@color/beat_highlight_color</item>
    </style>

    <style name="popup_window_animation">
        <item name="android:windowEnterAnimation">@anim/popup_anim</item>
        <item name="android:windowExitAnimation">@anim/popdown_anim</item>
    </style>
</resources>